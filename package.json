{
  "name": "@zerorandy/vaulter",
  "version": "0.1.0",
  "description": "Server-side file storage library for S3-compatible providers (Backblaze B2, Cloudflare R2, MinIO, AWS S3) with private bucket + proxy pattern.",
  "type": "module",
  "license": "MIT",
  "author": "zerorandy <renereyperez@gmail.com> (https://github.com/zerorandy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerorandy/vaulter"
  },
  "keywords": [
    "storage",
    "s3",
    "backblaze",
    "b2",
    "r2",
    "cloudflare",
    "minio",
    "proxy",
    "private-bucket",
    "media"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
